<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="cn.zswltech.mithras.leaseholdproperty.mapper.LeaseItemListRowDataMapper">
    <select id="listFreeItem" resultType="cn.zswltech.mithras.leaseholdproperty.mapper.model.LeaseItemListRowData">
        select
        id as id,
        lease_item_info_id as leaseItemInfoId,
        row_data as rowData
        from lease_item_list_row_data
        where
        lease_item_info_id = #{leaseItemInfoId}
        and id not in (
            select
            lease_item_row_data_id
            from contract_lease_item
            where contract_id in
            <foreach collection="contractIds" item="contractId" open="(" separator="," close=")">
                #{contractId}
            </foreach>
        )
    </select>
</mapper>
