<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="cn.zswltech.mithras.customer.infrastructure.persistence.mapper.client.ClientBusinessHistoryMapper">

    <select id="getLastByClientIds" resultType="cn.zswltech.mithras.customer.infrastructure.persistence.mapper.model.client.ClientBusinessHistory">
        select * from client_business_history where id in (
        select max(id) from client_business_history
        <where>
            client_id in
            <foreach collection="ids" item="item" index="index" open="(" separator="," close=")">
                #{item}
            </foreach>
        </where>
        group by client_id)
    </select>
</mapper>
