<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="cn.zswltech.mithras.customer.infrastructure.persistence.mapper.app.VisitRecordMapper">

    <select id="myList" resultType="cn.zswltech.mithras.customer.infrastructure.persistence.mapper.model.app.VisitRecord">
        select a.*
        from visit_record a
        <where>
            <if test="p.clientName!=null and p.clientName!=''">and a.client_name like CONCAT('%',#{p.clientName}, '%')
            </if>
            <if test="p.visitWays!=null and p.visitWays.size()>0">
                and a.visit_way in
                <foreach collection="p.visitWays" item="item" index="index" open="(" separator="," close=")">
                    #{item}
                </foreach>
            </if>
            <if test="p.visitTypes!=null and p.visitTypes.size()>0">
                and a.visit_type in
                <foreach collection="p.visitTypes" item="item" index="index" open="(" separator="," close=")">
                    #{item}
                </foreach>
            </if>
            <if test="p.visitPhases!=null and p.visitPhases.size()>0">
                and a.visit_phase in
                <foreach collection="p.visitPhases" item="item" index="index" open="(" separator="," close=")">
                    #{item}
                </foreach>
            </if>
            <if test="p.statuses!=null and p.statuses.size()>0">
                and a.status in
                <foreach collection="p.statuses" item="item" index="index" open="(" separator="," close=")">
                    #{item}
                </foreach>
            </if>
            <if test="p.visitTimeFrom!=null">and a.check_in_date &gt;= #{p.visitTimeFrom}</if>
            <if test="p.visitTimeTo!=null">and a.check_in_date &lt;= #{p.visitTimeTo}</if>
            <if test="p.targetVisitRecordIds!=null and p.targetVisitRecordIds.size()>0">
                and a.id in
                <foreach collection="p.targetVisitRecordIds" item="item" index="index" open="(" separator="," close=")">
                    #{item}
                </foreach>
            </if>
            <if test="p.clientIds!=null and p.clientIds.size()>0">
                and a.client_id in
                <foreach collection="p.clientIds" item="item" index="index" open="(" separator="," close=")">
                    #{item}
                </foreach>
            </if>
            <if test="p.userIds!=null and p.userIds.size()>0">
                and a.user_id in
                <foreach collection="p.userIds" item="item" index="index" open="(" separator="," close=")">
                    #{item}
                </foreach>
            </if>
        </where>
        order by check_in_date desc
    </select>
</mapper>
