<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="cn.zswltech.mithras.projectprocess.mapper.lib.projpricing.ProjPricingBaseInfoLibMapper">

    <select id="listNewestPreviewByClientIds"
            resultType="cn.zswltech.mithras.projectprocess.model.projpricing.ProjPricingBaseInfoLib">

        SELECT p.* FROM proj_pricing_base_info_lib p
        INNER JOIN (SELECT main_id AS id, MAX(version) AS version FROM common_version t1
        WHERE t1.module = 'PROJ_PRICING' AND t1.version_type = 1
        GROUP BY main_id) m ON p.origin_id = m.id AND p.version = m.version
        <where>
            <if test="region!=null and region.size() > 0">
                AND p.regional_project_classify IN
                <foreach collection="region" item="item" separator="," open="(" close=")">
                    #{item}
                </foreach>
            </if>
            <if test="clientIds != null and clientIds.size() > 0">
                AND p.client_id IN
                <foreach collection="clientIds" item="item" separator="," open="(" close=")">
                    #{item}
                </foreach>
            </if>
        </where>


    </select>
</mapper>
