<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="cn.zswltech.mithras.collection.mapper.CollectionOverdueRecordInfoMapper">


    <select id="getLastRecordByCollectionId" resultType="cn.zswltech.mithras.collection.mapper.model.CollectionOverdueRecordInfo">
        select id, max(record_date) as record_date
        from collection_overdue_record_info
        where collection_id in
        <foreach collection="ids" item="item" separator="," open="(" close=")">
            #{item}
        </foreach>
    </select>


</mapper>
