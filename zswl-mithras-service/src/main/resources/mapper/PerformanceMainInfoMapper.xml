<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="cn.zswltech.mithras.service.mapper.kpi.PerformanceMainInfoMapper">

    <resultMap id="BaseResultMap" type="cn.zswltech.mithras.service.mapper.model.kpi.PerformanceMainInfo">
            <id property="id" column="id" jdbcType="BIGINT"/>
            <result property="year" column="year" jdbcType="BIGINT"/>
            <result property="status" column="status" jdbcType="TINYINT"/>
            <result property="deleted" column="deleted" jdbcType="TINYINT"/>
            <result property="createBy" column="create_by" jdbcType="BIGINT"/>
            <result property="createTime" column="create_time" jdbcType="TIMESTAMP"/>
            <result property="updateBy" column="update_by" jdbcType="BIGINT"/>
            <result property="updateTime" column="update_time" jdbcType="TIMESTAMP"/>
    </resultMap>

    <sql id="Base_Column_List">
        id,year,status,
        deleted,create_by,create_time,
        update_by,update_time
    </sql>
    <select id="getDeptHead" resultType="java.lang.Long">
        SELECT org_id
        FROM gruul_user_org_job
        WHERE user_id = #{userId}
        AND job_code = 'businesshead'
        AND org_id NOT IN (7, 8, 10)
    </select>
</mapper>
